---
/** Política de privacidade (LGPD). Conteúdo em src/data/privacy.ts. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import { privacy } from '../data/privacy';
import { site } from '../data/site';
import { formatText, formatTitle } from '../utils/typography';
---

<BaseLayout
  title={privacy.title}
  description={`${privacy.title} do site de ${site.name}: sem formulários, sem cookies e sem coleta de dados de navegação.`}
>
  <Header slot="header" linkToHome />

  <Section reveal={false} class="privacy" aria-labelledby="privacy-title">
    <Container size="text">
      <header class="privacy__head">
        <Heading level={1} size="xl" id="privacy-title">
          <Fragment set:html={formatTitle(privacy.title)} />
        </Heading>
        <p class="privacy__updated">
          {`${privacy.updatedLabel}: `}
          <time datetime={privacy.updatedAt.iso}>{privacy.updatedAt.label}</time>
        </p>
        {privacy.intro.map((p) => (
          <p class="lead" set:html={formatText(p)} />
        ))}
      </header>

      <nav class="privacy__toc" aria-labelledby="privacy-toc">
        <h2 id="privacy-toc" class="privacy__toc-title">
          {privacy.tocLabel}
        </h2>
        <ol role="list">
          {privacy.sections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
        </ol>
      </nav>

      {privacy.sections.map((section) => (
        <section class="privacy__section" id={section.id} aria-labelledby={`${section.id}-title`}>
          <Heading level={2} size="md" id={`${section.id}-title`}>
            {section.title}
          </Heading>
          {section.paragraphs?.map((p) => (
            <p set:html={formatText(p)} />
          ))}
          {section.list && (
            <ul class="privacy__list">
              {section.list.map((item) => (
                <li set:html={formatText(item)} />
              ))}
            </ul>
          )}
          {section.after?.map((p) => (
            <p set:html={formatText(p)} />
          ))}
        </section>
      ))}
    </Container>
  </Section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .privacy {
    padding-block-start: calc(var(--header-h) + var(--header-offset) + var(--space-8));
  }

  .privacy__head {
    display: grid;
    gap: var(--space-5);
  }

  .privacy__updated {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .privacy__toc {
    margin-block: var(--space-stack);
    padding-block: var(--space-5);
    border-block: var(--border-hairline) solid var(--line);
  }

  .privacy__toc-title {
    margin-block-end: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .privacy__toc ol {
    display: grid;
    gap: var(--space-1);
    counter-reset: toc;
  }

  .privacy__toc li {
    counter-increment: toc;
  }

  /* Numeração editorial; alvo de toque ≥ 44px. */
  .privacy__toc a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 2.75rem;
    color: var(--fg);
    text-decoration: none;
  }

  .privacy__toc a::before {
    content: counter(toc, decimal-leading-zero);
    min-width: 1.5rem;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--fg-accent);
  }

  .privacy__toc a:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--border-hairline);
    text-underline-offset: 0.22em;
  }

  .privacy__section {
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-7);
  }

  .privacy__list {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: var(--space-5);
  }

  .privacy__list li::marker {
    color: var(--fg-muted);
  }
</style>
