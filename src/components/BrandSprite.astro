---
/**
 * Define os paths do wordmark uma única vez por página; Logo.astro os
 * reutiliza via <use>. Incluído pelo BaseLayout.
 */
import { wordmark } from './Logo.paths';
---

<svg class="brand-sprite" aria-hidden="true" focusable="false">
  <defs>
    <path id="wordmark-name" d={wordmark.name}></path>
    <path id="wordmark-tagline" d={wordmark.tagline}></path>
  </defs>
</svg>

<style>
  .brand-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
