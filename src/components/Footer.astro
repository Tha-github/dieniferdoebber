---
/**
 * Rodapé: wordmark, identificação profissional (CFP: nome e CRP visíveis),
 * ano, política de privacidade e aviso de que o site não é canal de emergência.
 * O ano é o do build; um redeploy anual o atualiza.
 */
import Container from './ui/Container.astro';
import Logo from './Logo.astro';
import WhatsAppFloat from './WhatsAppFloat.astro';
import { footer } from '../data/content';
import { site } from '../data/site';
import { formatText } from '../utils/typography';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-whatsapp-float-hide>
  <Container>
    <div class="site-footer__top">
      <Logo size="md" />
      <ul role="list" class="site-footer__id">
        <li>{footer.name}</li>
        <li>{footer.role}</li>
        <li>{footer.city}</li>
        <li>
          {footer.ePsi.href ? (
            <a href={footer.ePsi.href} {...site.externalLink}>
              {footer.ePsi.label}
              <span class="visually-hidden"> {site.newTabHint}</span>
            </a>
          ) : (
            <span>
              {footer.ePsi.label} <Fragment set:html={formatText(footer.ePsi.pending)} />
            </span>
          )}
          <span class="site-footer__note"> · {footer.ePsi.note}</span>
        </li>
      </ul>
    </div>

    <p class="site-footer__notice">{footer.emergencyNotice}</p>

    <div class="site-footer__bottom">
      <p>{footer.copyright(year)}</p>
      <a href={withBase(footer.privacyLink.href)}>{footer.privacyLink.label}</a>
    </div>
  </Container>

  <!-- Dentro do <footer> para ficar num landmark; a posição é fixa. -->
  <WhatsAppFloat />
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    background-color: var(--color-bg);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-6);
    padding-block-end: var(--space-7);
  }

  .site-footer__id {
    display: grid;
    gap: var(--space-1);
    color: var(--fg);
  }

  .site-footer__note {
    color: var(--fg-muted);
  }

  .site-footer__notice {
    padding-block: var(--space-5);
    border-block: var(--border-hairline) solid var(--line);
    color: var(--fg);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block-start: var(--space-5);
    color: var(--fg-muted);
  }

  .site-footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fg-muted);
  }

  .site-footer__bottom a:hover {
    color: var(--fg);
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: start;
    }

    .site-footer__top > :first-child {
      grid-column: 1 / span 5;
    }

    .site-footer__id {
      grid-column: 7 / -1;
    }
  }
</style>
