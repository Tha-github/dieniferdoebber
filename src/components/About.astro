---
/**
 * Sobre: título + CRP numa coluna, texto em primeira pessoa na outra.
 * Foto do consultório opcional (content.about.office): com foto, <Picture>;
 * sem foto, placeholder neutro; com showPlaceholder=false, o bloco some
 * e o layout se mantém.
 */
import { Picture } from 'astro:assets';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import Heading from './ui/Heading.astro';
import Divider from './ui/Divider.astro';
import { about } from '../data/content';
import { site } from '../data/site';
import { formatText } from '../utils/typography';

const { photo, showPlaceholder } = about.office;
const hasMedia = Boolean(photo) || showPlaceholder;
---

<Section id={about.id} aria-labelledby="sobre-title">
  <Container class:list={['about', { 'about--with-media': hasMedia }]}>
    <header class="about__head">
      <Heading level={2} id="sobre-title">
        {about.title}
      </Heading>
      <Divider length="short" class="about__rule" />
      <p class="about__crp">{site.crp.label}</p>
    </header>

    <div class="about__text">
      {about.paragraphs.map((paragraph, i) => (
        <p class:list={{ lead: i === 0 }} set:html={formatText(paragraph)} />
      ))}
    </div>

    {hasMedia && (
      <div class="about__media">
        {photo ? (
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            widths={[400, 640, 880, 1200]}
            sizes="(min-width: 64rem) 590px, 90vw"
            loading="lazy"
            decoding="async"
            class="about__photo"
          />
        ) : (
          <div class="about__photo about__photo--placeholder" aria-hidden="true" />
        )}
      </div>
    )}
  </Container>
</Section>

<style>
  .about {
    display: grid;
    grid-template-areas:
      'head'
      'text'
      'media';
    gap: var(--space-stack);
  }

  .about__head {
    grid-area: head;
  }

  .about__rule {
    margin-block: var(--space-5) var(--space-4);
  }

  .about__crp {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    color: var(--fg-muted);
  }

  .about__text {
    grid-area: text;
    display: grid;
    gap: var(--space-5);
    max-width: var(--container-text);
  }

  .about__media {
    grid-area: media;
  }

  .about__photo {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background-color: var(--color-sand);
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas: none;
      column-gap: var(--space-5);
      row-gap: var(--space-7);
      align-items: start;
    }

    .about__head {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    .about__text {
      grid-column: 7 / -1;
      grid-row: 1;
      /* Alinha a primeira linha do texto com o topo do título. */
      padding-block-start: var(--space-3);
    }

    /* Foto sob o texto, na mesma coluna e largura de leitura. */
    .about__media {
      grid-column: 7 / -1;
      grid-row: 2;
      max-width: var(--container-text);
    }
  }
</style>
