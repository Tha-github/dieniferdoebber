---
/**
 * Wordmark "Dienifer Doebber · Psicanálise · Psicologia Clínica".
 * Texto convertido em paths (Logo.paths.ts, gerado por `npm run brand`),
 * então não depende da fonte carregada e não causa layout shift.
 * Os paths ficam no BrandSprite (BaseLayout) e são referenciados via <use>.
 */
import type { HTMLAttributes } from 'astro/types';
import { site } from '../data/site';
import { wordmark } from './Logo.paths';

interface Props extends Omit<HTMLAttributes<'svg'>, 'width' | 'viewBox' | 'style'> {
  /** Exibe a linha "Psicanálise · Psicologia Clínica". */
  tagline?: boolean;
  /**
   * Largura: sm 9.5rem · md 12rem · lg 13rem. A altura acompanha a
   * proporção. Tamanhos fixos em classes (sem style=), por causa da CSP.
   */
  size?: 'sm' | 'md' | 'lg';
}

const { tagline = true, size = 'lg', class: className, ...rest } = Astro.props;

// Sem a tagline, recorta o viewBox até a base do nome.
const [x, y, w] = wordmark.viewBox.split(' ').map(Number);
const viewBox = tagline ? wordmark.viewBox : `${x} ${y} ${w} ${wordmark.nameHeight}`;
const label = tagline ? `${site.name}, ${site.tagline}` : site.name;
---

<svg
  class:list={['logo', `logo--${size}`, className]}
  viewBox={viewBox}
  role="img"
  aria-label={label}
  focusable="false"
  {...rest}
>
  <use href="#wordmark-name"></use>
  {tagline && <use href="#wordmark-tagline"></use>}
</svg>

<style>
  .logo {
    display: block;
    width: 13rem;
    height: auto;
    fill: currentColor;
    color: var(--color-navy);
  }

  .logo--sm {
    width: 9.5rem;
  }

  .logo--md {
    width: 12rem;
  }
</style>
