---
/**
 * Formação e trajetória: lista com filetes (Formação) e linha do tempo
 * vertical (Trajetória, do mais recente para o mais antigo).
 * Marcadores de pendência aparecem com a classe temporária .pending.
 */
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import Heading from './ui/Heading.astro';
import Eyebrow from './ui/Eyebrow.astro';
import { education } from '../data/content';
import { formatText, formatTitle } from '../utils/typography';

const timeline = [...education.timeline].sort((a, b) => Number(b.year) - Number(a.year));
---

<Section variant="surface" id={education.id} aria-labelledby="formacao-title">
  <Container>
    <Heading level={2} id="formacao-title" class="education__title">
      <Fragment set:html={formatTitle(education.title)} />
    </Heading>

    <div class="education">
      <div class="education__col">
        <Eyebrow as="h3" class="education__label">
          {education.educationTitle}
        </Eyebrow>
        <ul role="list" class="edu-list">
          {education.educationItems.map((item) =>
            item.detail ? (
              <li class="edu-item">
                <span class="edu-item__area">{item.area}</span>
                <span class="edu-item__detail" set:html={formatText(item.detail)} />
              </li>
            ) : (
              <li class="edu-item edu-item--single">
                <span class="edu-item__detail" set:html={formatText(item.area)} />
              </li>
            ),
          )}
        </ul>
      </div>

      <div class="education__col">
        <Eyebrow as="h3" class="education__label">
          {education.timelineTitle}
        </Eyebrow>
        <ol role="list" class="timeline">
          {timeline.map((entry) => (
            <li class="timeline__item">
              <time class="timeline__year" datetime={entry.year}>
                {entry.year}
              </time>
              <div class="timeline__body">
                <p class="timeline__title" set:html={formatText(entry.title)} />
                <p class="timeline__text" set:html={formatText(entry.text)} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Container>
</Section>

<style>
  .education__title {
    margin-block-end: var(--space-stack);
  }

  .education {
    display: grid;
    gap: var(--space-stack);
  }

  .education__label {
    margin-block-end: var(--space-5);
  }

  /* ── Formação ──────────────────────────────────────────── */
  .edu-list {
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .edu-item {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-top: var(--border-hairline) solid var(--line);
  }

  .edu-item__area {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* Instituição: destaque sutil em Cormorant. */
  .edu-item__detail {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    color: var(--fg);
  }

  @media (min-width: 48rem) {
    .edu-item {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: var(--space-5);
      align-items: baseline;
    }

    .edu-item--single .edu-item__detail {
      grid-column: 2;
    }
  }

  /* ── Trajetória (linha do tempo) ───────────────────────── */
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-7);
    padding-block-start: var(--space-5);
    border-top: var(--border-hairline) solid var(--line);
  }

  .timeline__item {
    --year-size: var(--text-2xl);
    /* Centro ótico dos algarismos do ano (line-height 1). */
    --marker-y: calc(var(--year-size) * 0.55);

    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    column-gap: var(--space-6);
  }

  /* Filete vertical contínuo entre o ano e o texto. */
  .timeline__item::before {
    content: '';
    position: absolute;
    top: var(--marker-y);
    bottom: calc(var(--space-7) * -1);
    left: calc(4.5rem + var(--space-6) / 2);
    width: var(--border-hairline);
    background-color: var(--line);
  }

  .timeline__item:last-child::before {
    bottom: 0;
  }

  /* Marcador: pequeno quadrado em linha fina, alinhado ao ano. */
  .timeline__item::after {
    content: '';
    position: absolute;
    top: var(--marker-y);
    left: calc(4.5rem + var(--space-6) / 2);
    width: 7px;
    height: 7px;
    border: var(--border-hairline) solid var(--fg-accent);
    background-color: var(--surface-current);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .timeline__year {
    font-family: var(--font-serif);
    font-size: var(--year-size);
    font-weight: var(--weight-regular);
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--fg-accent);
  }

  .timeline__body {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: var(--space-2);
  }

  .timeline__title {
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .timeline__text {
    color: var(--fg-muted);
  }

  @media (min-width: 64rem) {
    .education {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
    }

    .education__col:first-child {
      grid-column: 1 / span 5;
    }

    .education__col:last-child {
      grid-column: 7 / -1;
    }

    .edu-item {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .timeline__item {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }

    .timeline__item::before,
    .timeline__item::after {
      left: calc(5.5rem + var(--space-6) / 2);
    }

    .timeline__item {
      --year-size: var(--text-3xl);
    }
  }
</style>
