---
/**
 * Botão flutuante do WhatsApp: círculo marinho, ícone em linha off-white.
 * Fica oculto enquanto qualquer elemento com [data-whatsapp-float-hide]
 * estiver visível (hero, Contato, rodapé) — aparece ao sair do hero e não
 * concorre com o botão da seção Contato. Sai oculto do HTML para não piscar
 * sobre o hero; sem JS, o <noscript> do BaseLayout o exibe.
 */
import { site } from '../data/site';
---

<a
  href={site.whatsapp.href}
  class="wa-float is-hidden"
  aria-label={site.whatsapp.ariaLabel}
  data-whatsapp-float
  {...site.externalLink}
>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
    <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z"></path>
    <path d="M9.1 8.3c.3-.4.7-.4 1 0l.8 1.4c.2.3.1.7-.1.9l-.6.6a6.2 6.2 0 0 0 2.6 2.6l.6-.6c.2-.2.6-.3.9-.1l1.4.8c.4.3.4.7 0 1l-.6.6c-.5.5-1.3.7-2 .4a8.5 8.5 0 0 1-4.6-4.6c-.3-.7-.1-1.5.4-2z"></path>
  </svg>
</a>

<style>
  .wa-float {
    --wa-size: 3.25rem; /* 52px */
    --wa-offset: var(--space-4);

    position: fixed;
    right: calc(var(--wa-offset) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--wa-offset) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-floating);
    display: grid;
    place-items: center;
    width: var(--wa-size);
    height: var(--wa-size);
    border-radius: var(--radius-full);
    background-color: var(--color-navy);
    color: var(--color-bg);
    box-shadow: var(--shadow-subtle);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility 0s linear 0s,
      background-color var(--duration-fast) var(--ease-out);
  }

  .wa-float:hover {
    background-color: var(--color-navy-soft);
  }

  .wa-float:focus-visible {
    outline-color: var(--color-navy);
  }

  /* Oculto: fora da árvore de foco (visibility) e sem layout shift. */
  .wa-float.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--space-2));
    pointer-events: none;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }

  .wa-float svg {
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 64rem) {
    .wa-float {
      --wa-size: 3.5rem; /* 56px */
      --wa-offset: var(--space-6);
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLElement>('[data-whatsapp-float]');
  const zones = document.querySelectorAll<HTMLElement>('[data-whatsapp-float-hide]');

  if (button) {
    const visible = new Set<Element>();
    const update = () => button.classList.toggle('is-hidden', visible.size > 0);

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      update();
    });

    zones.forEach((zone) => observer.observe(zone));
    // Página sem zonas (ex.: política de privacidade): sempre visível.
    if (zones.length === 0) update();
  }
</script>
