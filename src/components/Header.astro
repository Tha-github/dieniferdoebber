---
/**
 * Header fixo. Transparente no topo da página; ao rolar, ganha fundo
 * off-white, filete inferior e fica compacto (IntersectionObserver num
 * sentinela, sem listener de scroll). Só transform/opacity animam, para
 * não gerar layout shift.
 *
 * Menu mobile: <dialog> modal (showModal) — o resto da página fica inerte,
 * ESC fecha nativamente, e o Tab circula dentro do menu.
 */
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';
import { site } from '../data/site';
import { contact } from '../data/content';
import { withBase } from '../utils/url';

interface Props {
  /**
   * false na home (âncoras "#sobre"); true nas demais páginas (404, política),
   * para que as âncoras levem de volta à seção na home ("<base>/#sobre").
   */
  linkToHome?: boolean;
}

const { linkToHome = false } = Astro.props;
const anchorBase = linkToHome ? withBase('/') : '';
const homeHref = withBase('/');

// "Contato" aparece como botão em linha fina no desktop, não como âncora repetida.
const contactAnchor = `#${contact.id}`;
const contactHref = anchorBase + contactAnchor;
const desktopLinks = site.nav.items.filter((item) => item.href !== contactAnchor);
---

<div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>

<header class="site-header is-top" data-site-header>
  <div class="site-header__bg" aria-hidden="true"></div>
  <Container class="site-header__inner">
    <a href={homeHref} class="site-header__brand">
      <Logo tagline={false} size="sm" class="site-header__logo site-header__logo--compact" />
      <Logo size="lg" class="site-header__logo site-header__logo--full" />
    </a>

    <nav class="site-nav" aria-label={site.nav.ariaLabel}>
      <ul role="list" class="site-nav__list">
        {desktopLinks.map((item) => (
          <li>
            <a href={anchorBase + item.href} class="site-nav__link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button variant="secondary" href={contactHref} class="site-nav__cta">
        {site.nav.contactButton}
      </Button>
    </nav>

    <button
      type="button"
      class="menu-button"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-menu-open
    >
      <span class="visually-hidden">{site.nav.menuOpen}</span>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
        <path d="M3 9h18M3 15h18"></path>
      </svg>
    </button>
  </Container>
</header>

<dialog id="menu-mobile" class="mobile-menu" aria-label={site.nav.menuLabel} data-menu>
  <Container class="mobile-menu__bar">
    <a href={homeHref} class="site-header__brand">
      <Logo tagline={false} size="sm" />
    </a>
    <button type="button" class="menu-button" data-menu-close autofocus>
      <span class="visually-hidden">{site.nav.menuClose}</span>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
  </Container>

  <Container as="nav" class="mobile-menu__nav" aria-label={site.nav.ariaLabel}>
    <ol role="list" class="mobile-menu__list">
      {site.nav.items.map((item, i) => (
        <li>
          <a href={anchorBase + item.href} class="mobile-menu__link">
            <span class="mobile-menu__number" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </Container>
</dialog>

<style>
  /* Sentinela: enquanto visível, a página está no topo. */
  .header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: var(--space-6);
    pointer-events: none;
  }

  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
  }

  .site-header__bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-bg);
    border-bottom: var(--border-hairline) solid var(--color-sand);
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: 100%;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  /* Estado "topo": sem fundo e com respiro extra (via transform, sem reflow). */
  .site-header.is-top .site-header__bg {
    opacity: 0;
  }

  .site-header.is-top .site-header__inner {
    transform: translateY(var(--header-offset));
  }

  /* Alvo de toque ≥ 44px também na versão compacta do wordmark. */
  .site-header__brand {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
  }

  .site-header__logo {
    transform-origin: left center;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .site-header:not(.is-top) .site-header__logo--full {
    transform: scale(0.88);
  }

  .site-header__logo--full,
  .site-nav {
    display: none;
  }

  @media (min-width: 48rem) {
    .site-header__logo--compact {
      display: none;
    }

    .site-header__logo--full {
      display: block;
    }
  }

  /* ── Navegação desktop ─────────────────────────────────── */
  @media (min-width: 64rem) {
    .site-nav {
      display: flex;
      align-items: center;
      gap: var(--space-7);
    }

    .site-header .menu-button {
      display: none;
    }
  }

  .site-nav__list {
    display: flex;
    gap: var(--space-6);
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--fg);
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-2);
    height: var(--border-hairline);
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='true']::after {
    transform: scaleX(1);
  }

  .site-nav .site-nav__cta {
    min-height: 2.75rem;
    padding-inline: var(--space-5);
  }

  /* ── Botão de menu (abrir/fechar) ──────────────────────── */
  .menu-button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: calc(var(--space-2) * -1);
    color: var(--fg);
  }

  .menu-button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
  }

  /* ── Menu mobile (tela cheia) ──────────────────────────── */
  .mobile-menu {
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
    animation: menu-in var(--duration-slow) var(--ease-out);
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--space-2) * -1));
    }
  }

  .mobile-menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: calc(var(--header-h) + var(--header-offset) * 2);
    border-bottom: var(--border-hairline) solid var(--color-sand);
  }

  .mobile-menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: var(--space-7);
  }

  .mobile-menu__list {
    display: grid;
    gap: var(--space-2);
    width: 100%;
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: var(--leading-snug);
    color: var(--fg);
    text-decoration: none;
  }

  /* Seção atual: filete sob o rótulo (cor sozinha não basta — ink ≈ navy). */
  .mobile-menu__link[aria-current='true'] {
    text-decoration: underline;
    text-decoration-thickness: var(--border-hairline);
    text-underline-offset: 0.2em;
  }

  .mobile-menu__link[aria-current='true'] .mobile-menu__number {
    color: var(--fg-accent);
  }

  .mobile-menu__number {
    min-width: 1.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
  }

  /* Trava a rolagem da página enquanto o menu está aberto. */
  :global(html:has(.mobile-menu[open])) {
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const sentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');

  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-top', entry?.isIntersecting ?? false);
    }).observe(sentinel);
  }

  // aria-current: marca, no menu desktop e no mobile, o link da seção que
  // cruza a faixa central da viewport (sem seção na faixa, nenhum link).
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '[data-site-header] a[href^="#"], [data-menu] a[href^="#"]',
    ),
  );
  const sectionIds = [...new Set(navLinks.map((link) => link.hash.slice(1)))];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const inBand = new Set<string>();
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target.id);
          else inBand.delete(entry.target.id);
        }
        const current = sectionIds.find((id) => inBand.has(id));
        for (const link of navLinks) {
          if (current && link.hash === `#${current}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  if (menu && openButton) {
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    openButton.addEventListener('click', () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });

    // Ao seguir um link, o foco acompanha a âncora; nos demais casos
    // (ESC, botão fechar) volta explicitamente ao botão de abrir — o Safari
    // não foca botões no clique, então a restauração nativa não basta.
    let linkTarget: HTMLElement | null = null;

    // ESC dispara "close" nativamente.
    menu.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      if (linkTarget) {
        if (!linkTarget.hasAttribute('tabindex')) linkTarget.setAttribute('tabindex', '-1');
        linkTarget.focus({ preventScroll: true });
      } else {
        openButton.focus();
      }
      linkTarget = null;
    });

    menu.addEventListener('click', (event) => {
      const target = event.target as Element;
      const link = target.closest<HTMLAnchorElement>('a[href]');
      if (link) {
        linkTarget = link.hash ? document.getElementById(link.hash.slice(1)) : null;
        menu.close();
      } else if (target.closest('[data-menu-close]')) {
        menu.close();
      }
    });

    // Mantém o Tab dentro do menu (inclusive ao sair do último item).
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Ao ampliar para desktop com o menu aberto, fecha.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>
