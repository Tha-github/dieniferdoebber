---
/**
 * Hero editorial assimétrico: texto à esquerda, retrato 4:5 à direita.
 * Sem foto (content.hero.portrait indefinido), exibe placeholder neutro em sand.
 */
import { Picture } from 'astro:assets';
import Section from './ui/Section.astro';
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Heading from './ui/Heading.astro';
import Button from './ui/Button.astro';
import { hero } from '../data/content';
import { site } from '../data/site';
import { formatText, formatTitle } from '../utils/typography';
---

<Section
  spacing="none"
  reveal={false}
  class="hero"
  aria-labelledby="hero-title"
  data-whatsapp-float-hide
>
  <Container class="hero__grid">
    <div class="hero__content">
      <Eyebrow>{hero.eyebrow}</Eyebrow>
      <Heading level={1} size="display" id="hero-title" class="hero__title">
        <Fragment set:html={formatTitle(hero.title)} />
      </Heading>
      <p class="lead hero__text" set:html={formatText(hero.text)} />

      <div class="hero__actions">
        <Button href={hero.primaryCta.href} external hint={site.whatsapp.ctaHint}>
          {hero.primaryCta.label}
        </Button>
        <Button variant="link" arrow="down" href={hero.secondaryCta.href}>
          {hero.secondaryCta.label}
        </Button>
      </div>

      <p class="hero__crp">{hero.crp}</p>
    </div>

    <div class="hero__media">
      {hero.portrait ? (
        // Acima da dobra: carregamento imediato e prioridade alta (candidato a LCP).
        <Picture
          src={hero.portrait.src}
          alt={hero.portrait.alt}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 75rem) 384px, (min-width: 48rem) 30vw, 80vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="hero__portrait"
        />
      ) : (
        <div class="hero__portrait hero__portrait--placeholder" aria-hidden="true" />
      )}
    </div>
  </Container>
</Section>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + var(--header-offset) + var(--space-5)) var(--space-8);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-8);
  }

  .hero__title {
    margin-block: var(--space-4) var(--space-5);
    max-width: 17ch;
  }

  .hero__text {
    max-width: 38ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-block-start: var(--space-5);
  }

  .hero__crp {
    margin-block-start: var(--space-5);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    color: var(--fg-muted);
  }

  /* Retrato: no mobile fica abaixo do texto, recuado à direita. */
  .hero__media {
    width: min(80%, 22rem);
    margin-inline-start: auto;
  }

  .hero__portrait {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background-color: var(--color-sand);
  }

  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: center;
    }

    .hero__content {
      grid-column: 1 / span 7;
    }

    .hero__media {
      grid-column: 9 / -1;
      width: 100%;
      margin: 0;
    }
  }

  /* Tablet: coluna de texto estreita; usa o h1 da escala para não forçar quebras. */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .hero__title {
      font-size: var(--text-4xl);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      min-height: 85vh;
      min-height: 85svh;
      padding-block-end: var(--space-9);
    }

    .hero__media {
      /* Assimetria: o retrato desce em relação ao bloco de texto. */
      margin-block-start: var(--space-9);
    }

    .hero__actions {
      margin-block-start: var(--space-7);
    }

    .hero__crp {
      margin-block-start: var(--space-8);
    }
  }
</style>
