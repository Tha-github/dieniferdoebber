---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  /** bg = off-white · surface = bege claro · navy = seção escura */
  variant?: 'bg' | 'surface' | 'navy';
  /** Espaçamento vertical: padrão (fluido) ou nenhum (a seção define o próprio). */
  spacing?: 'default' | 'none';
  /**
   * Reveal sutil ao entrar na viewport (fade + 14px, 400ms). Aplicado ao
   * conteúdo, não à seção, para o fundo não desbotar. Desligado com
   * prefers-reduced-motion. Use false em conteúdo acima da dobra (hero).
   */
  reveal?: boolean;
}

const {
  variant = 'bg',
  spacing = 'default',
  reveal = true,
  class: className,
  ...rest
} = Astro.props;
---

<section
  class:list={['section', `section--${spacing}`, className]}
  data-surface={variant === 'bg' ? undefined : variant}
  {...rest}
>
  {reveal ? (
    <div data-reveal>
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>

<style>
  .section {
    background-color: var(--surface-current);
    color: var(--fg);
  }

  .section--default {
    padding-block: var(--space-section);
  }
</style>

<script>
  // Só anima se o usuário não pediu movimento reduzido; sem JS (ou sem IO),
  // o conteúdo fica visível — o estado oculto depende da classe .js-reveal.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (!reduce && 'IntersectionObserver' in window && targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
    document.documentElement.classList.add('js-reveal');
  }
</script>
