---
/** Seta em linha fina (1.25px), decorativa. */
interface Props {
  direction?: 'right' | 'down';
  size?: number;
  class?: string;
}

const { direction = 'right', size = 18, class: className } = Astro.props;
---

<svg
  class:list={['arrow-icon', `arrow-icon--${direction}`, className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 12h15M13 6l6 6-6 6"></path>
</svg>

<style>
  .arrow-icon {
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: var(--icon-stroke);
    stroke-linecap: square;
  }

  .arrow-icon--down {
    rotate: 90deg;
  }
</style>
