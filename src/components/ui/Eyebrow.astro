---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {
  /** Use h2/h3 quando o sobretítulo também for o título de um bloco. */
  as?: 'p' | 'span' | 'div' | 'h2' | 'h3';
}

const { as: Tag = 'p', class: className, ...rest } = Astro.props;
---

<Tag class:list={['eyebrow', className]} {...rest}>
  <slot />
</Tag>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }
</style>
