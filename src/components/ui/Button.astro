---
import type { HTMLAttributes } from 'astro/types';
import { site } from '../../data/site';
import ArrowIcon from './ArrowIcon.astro';

type Variant = 'primary' | 'secondary' | 'link';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  /** primary = marinho sólido · secondary = linha fina · link = texto com seta */
  variant?: Variant;
  /** Direção da seta. Padrão: "right" na variante link, nenhuma nas demais. */
  arrow?: 'right' | 'down' | 'none';
  /**
   * Abre em nova aba com target/rel padronizados (site.externalLink) e acrescenta
   * "(abre em nova aba)" oculto ao nome acessível.
   */
  external?: boolean;
  /**
   * Complemento oculto do nome acessível (ex.: "pelo WhatsApp"). Preferir isto a
   * aria-label: o texto visível continua no nome (WCAG 2.5.3, Label in Name).
   */
  hint?: string;
  class?: string;
}

const {
  variant = 'primary',
  arrow = variant === 'link' ? 'right' : 'none',
  external = false,
  hint,
  href,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, className];
const linkAttrs = external ? site.externalLink : {};
const srText = [hint, external ? site.newTabHint : undefined].filter(Boolean).join(' ');
---

<a href={href} class:list={classes} {...linkAttrs} {...rest}>
  <span class="btn__label">
    <slot />
    {srText && <span class="visually-hidden"> {srText}</span>}
  </span>
  {arrow !== 'none' && <ArrowIcon direction={arrow} class="btn__arrow" />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-none);
    transition: var(--transition-colors);
    -webkit-tap-highlight-color: transparent;
  }

  /* Primário: marinho sólido */
  .btn--primary {
    min-height: 3rem;
    padding: var(--space-3) var(--space-6);
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-fg);
    border: var(--border-hairline) solid var(--btn-primary-bg);
  }

  .btn--primary:hover {
    background-color: var(--btn-primary-bg-hover);
    border-color: var(--btn-primary-bg-hover);
  }

  /* Secundário: linha fina */
  .btn--secondary {
    min-height: 3rem;
    padding: var(--space-3) var(--space-6);
    background-color: transparent;
    color: var(--btn-secondary-fg);
    border: var(--border-hairline) solid var(--btn-secondary-border);
  }

  .btn--secondary:hover {
    background-color: var(--btn-secondary-bg-hover);
    color: var(--btn-secondary-fg-hover);
    border-color: var(--btn-secondary-bg-hover);
  }

  /* Link com seta */
  .btn--link {
    min-height: 2.75rem; /* alvo de toque ≥ 44px */
    padding: 0;
    color: var(--fg-accent);
  }

  .btn--link .btn__label {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% var(--border-hairline);
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-block-end: 2px;
    transition: background-size var(--duration-base) var(--ease-out);
  }

  .btn--link:hover .btn__label {
    background-size: 100% var(--border-hairline);
  }

  /* A seta (ArrowIcon) é um componente filho: estilo via :global. */
  .btn :global(.btn__arrow) {
    transition: translate var(--duration-base) var(--ease-out);
  }

  .btn:hover :global(.arrow-icon--right) {
    translate: 3px 0;
  }

  .btn:hover :global(.arrow-icon--down) {
    translate: 0 3px;
  }
</style>
