---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  /** text ≈ 680px (leitura) · content ≈ 1200px (padrão) */
  size?: 'text' | 'content';
  as?: 'div' | 'header' | 'footer' | 'article' | 'nav';
}

const { size = 'content', as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['container', `container--${size}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    /* viewport-fit=cover: respeita o notch em paisagem (iOS). */
    padding-inline: max(var(--space-gutter), env(safe-area-inset-left, 0px))
      max(var(--space-gutter), env(safe-area-inset-right, 0px));
  }

  .container--content {
    max-width: calc(var(--container-content) + 2 * var(--space-gutter));
  }

  .container--text {
    max-width: calc(var(--container-text) + 2 * var(--space-gutter));
  }
</style>
