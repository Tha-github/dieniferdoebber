---
import type { HTMLAttributes } from 'astro/types';

type Level = 1 | 2 | 3 | 4;
type Size = 'display' | 'xl' | 'lg' | 'md' | 'sm';

interface Props extends HTMLAttributes<'h2'> {
  /** Nível semântico (h1–h4). */
  level?: Level;
  /** Tamanho visual, independente do nível. Padrão: segue o nível. */
  size?: Size;
}

const defaultSize: Record<Level, Size> = { 1: 'xl', 2: 'lg', 3: 'md', 4: 'sm' };

const { level = 2, size, class: className, ...rest } = Astro.props;
const Tag = `h${level}` as const;
const visualSize = size ?? defaultSize[level];
---

<Tag class:list={['heading', `heading--${visualSize}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .heading {
    font-family: var(--font-serif);
    color: var(--fg);
    text-wrap: balance;
  }

  .heading--display {
    font-size: var(--text-5xl);
    font-weight: var(--weight-regular);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .heading--xl {
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
  }

  .heading--lg {
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
  }

  .heading--md {
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .heading--sm {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: 0;
  }
</style>
